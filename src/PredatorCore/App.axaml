<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PredatorCore.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <FontFamily x:Key="BodyFont">avares://PredatorCore/Assets/Fonts/TitilliumWeb-Regular.ttf#Titillium Web</FontFamily>
        <FontFamily x:Key="SemiFont">avares://PredatorCore/Assets/Fonts/TitilliumWeb-SemiBold.ttf#Titillium Web</FontFamily>

        <!-- New Horizon print style: a black page, white type, hairline rules and one accent.
             The accent is coolant, taken from the teal disc of the fan illustration. -->
        <Color x:Key="PsAccentColor">#4FC3DC</Color>
        <SolidColorBrush x:Key="PsBg" Color="#000000" />
        <SolidColorBrush x:Key="PsRule" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="PsRuleStrong" Color="#47FFFFFF" />
        <SolidColorBrush x:Key="PsAccent" Color="#4FC3DC" />
        <SolidColorBrush x:Key="PsAccentDark" Color="#2F9FBD" />
        <SolidColorBrush x:Key="PsOnAccent" Color="#0F0F0E" />
        <!-- second data series (GPU), printed in cream paper -->
        <SolidColorBrush x:Key="PsSecond" Color="#EBE5C8" />
        <SolidColorBrush x:Key="PsText" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PsSoft" Color="#E0FFFFFF" />
        <SolidColorBrush x:Key="PsMuted" Color="#8FFFFFFF" />
        <SolidColorBrush x:Key="PsGood" Color="#8FBF5A" />
        <SolidColorBrush x:Key="PsWarn" Color="#E3A52A" />
        <SolidColorBrush x:Key="PsCritical" Color="#FF6A4D" />

        <!-- The drawn wordmark: monoline strokes with cut joins, in a 586 x 92 box (stroke 6.5) -->
        <StreamGeometry x:Key="WordmarkGeometry">M3.25 33.25 V95.5M7.86 41.61 A21.75 21.75 0 1 1 7.86 68.39M58.75 33.25 V76.75M63.95 40.5 C67.75 35.5 72.75 33.25 78.75 33.25 H82.75M137.25 55 A21.75 21.75 0 1 0 130.88 70.38M99.75 55 H137.25M188.14 41.61 A21.75 21.75 0 1 0 188.14 68.39M192.75 16 V76.75M246.89 41.61 A21.75 21.75 0 1 0 246.89 68.39M251.5 33.25 V76.75M278.75 16 V66 Q278.75 76.75 289.75 76.75M266.75 33.25 H272.5 M285 33.25 H292.75M303.75 55 A21.75 21.75 0 1 0 347.25 55 A21.75 21.75 0 1 0 303.75 55M359.25 33.25 V76.75M364.45 40.5 C368.25 35.5 373.25 33.25 379.25 33.25 H383.25M433.14 41.61 A21.75 21.75 0 1 0 433.14 68.39M445.14 55 A21.75 21.75 0 1 0 488.64 55 A21.75 21.75 0 1 0 445.14 55M500.64 33.25 V76.75M505.84 40.5 C509.64 35.5 514.64 33.25 520.64 33.25 H524.64M579.14 55 A21.75 21.75 0 1 0 572.77 70.38M541.64 55 H579.14</StreamGeometry>

        <!-- Square corners everywhere -->
        <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
        <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
        <CornerRadius x:Key="SliderThumbCornerRadius">0</CornerRadius>

        <!-- Fluent control colours -->
        <SolidColorBrush x:Key="SliderTrackFill" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#47FFFFFF" />
        <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#47FFFFFF" />
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="#4FC3DC" />
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#4FC3DC" />
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#2F9FBD" />
        <SolidColorBrush x:Key="SliderThumbBackground" Color="#4FC3DC" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#2F9FBD" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#0F0F0E" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#0F0F0E" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#0F0F0E" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#0F0F0E" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#0F0F0E" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#0F0F0E" />
        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#000000" />
        <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#47FFFFFF" />
        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#47FFFFFF" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#8FFFFFFF" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#4FC3DC" />
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF" />

        <Color x:Key="SystemAccentColor">#4FC3DC</Color>
        <Color x:Key="SystemAccentColorLight1">#6FCFE3</Color>
        <Color x:Key="SystemAccentColorLight2">#8FDBEA</Color>
        <Color x:Key="SystemAccentColorLight3">#AFE7F1</Color>
        <Color x:Key="SystemAccentColorDark1">#2F9FBD</Color>
        <Color x:Key="SystemAccentColorDark2">#227C94</Color>
        <Color x:Key="SystemAccentColorDark3">#16596B</Color>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Material.Icons.Avalonia/MaterialIconStyles.axaml" />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    </Application.Styles>

    <Application.Styles>
        <!-- ============ Type ============ -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource PsBg}" />
            <Setter Property="Foreground" Value="{StaticResource PsText}" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!-- Page title -->
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="LetterSpacing" Value="-0.6" />
            <Setter Property="Foreground" Value="{StaticResource PsText}" />
            <Setter Property="Margin" Value="0 0 0 2" />
        </Style>

        <Style Selector="TextBlock.SectionSub">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource PsMuted}" />
            <Setter Property="Margin" Value="0 0 0 34" />
        </Style>

        <!-- Section title, under the section's hairline -->
        <Style Selector="TextBlock.SubHeader">
            <Setter Property="FontFamily" Value="{StaticResource SemiFont}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="{StaticResource PsText}" />
            <Setter Property="Margin" Value="0 0 0 4" />
        </Style>

        <Style Selector="TextBlock.Hint">
            <Setter Property="Foreground" Value="{StaticResource PsMuted}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.Label">
            <Setter Property="Foreground" Value="{StaticResource PsMuted}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style Selector="TextBlock.Value">
            <Setter Property="FontFamily" Value="{StaticResource SemiFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource PsText}" />
        </Style>

        <Style Selector="TextBlock.BigValue">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="LetterSpacing" Value="-0.5" />
            <Setter Property="Foreground" Value="{StaticResource PsText}" />
        </Style>

        <Style Selector="TextBlock.Warning">
            <Setter Property="Foreground" Value="{StaticResource PsWarn}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- ============ Sections: a hairline on top, no box ============ -->
        <Style Selector="Border.Card">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource PsRule}" />
            <Setter Property="BorderThickness" Value="0 1 0 0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0 16 0 0" />
            <Setter Property="Margin" Value="0 0 0 38" />
        </Style>

        <!-- A hairline-boxed panel inside a section -->
        <Style Selector="Border.Tile">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource PsRule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="16 12" />
        </Style>

        <!-- ============ Sidebar navigation (TabControl on the left) ============ -->
        <Style Selector="TabControl.Nav">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="220" Background="{StaticResource PsBg}"
                                BorderBrush="{StaticResource PsRule}" BorderThickness="0 0 1 0">
                            <Grid RowDefinitions="*,Auto">
                                <ItemsPresenter Name="PART_ItemsPresenter" Margin="0 18 0 0"
                                                ItemsPanel="{TemplateBinding ItemsPanel}" />
                                <!-- the fan, cut from paper: the brand's illustration -->
                                <Image Grid.Row="1" Source="avares://PredatorCore/Assets/Art/spot-fan.png"
                                       Width="184" Height="184" Margin="18 0 18 22" Opacity="0.95"
                                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                            </Grid>
                        </Border>
                        <ContentPresenter Name="PART_SelectedContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                    </DockPanel>
                </ControlTemplate>
            </Setter>
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </Setter>
        </Style>

        <Style Selector="TabControl.Nav > TabItem">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource PsMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent">
                        <Grid ColumnDefinitions="2,*">
                            <Border Name="navIndicator" Grid.Column="0" Background="Transparent" Margin="0 9" />
                            <ContentPresenter Grid.Column="1" Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              VerticalAlignment="Center"
                                              Margin="22 0 12 0" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TabControl.Nav > TabItem:pointerover">
            <Setter Property="Foreground" Value="{StaticResource PsText}" />
        </Style>
        <Style Selector="TabControl.Nav > TabItem:selected">
            <Setter Property="Foreground" Value="{StaticResource PsText}" />
        </Style>
        <Style Selector="TabControl.Nav > TabItem:selected /template/ Border#navIndicator">
            <Setter Property="Background" Value="{StaticResource PsAccent}" />
        </Style>

        <!-- ============ Buttons: two plates of one ink, printed out of register ============ -->
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="{StaticResource SemiFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Background" Value="{StaticResource PsAccent}" />
            <Setter Property="Foreground" Value="{StaticResource PsOnAccent}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18 7" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border Name="plateA" Background="{TemplateBinding Background}" Margin="0 0 5 3" />
                        <Border Name="plateB" Background="{TemplateBinding Background}" Margin="5 3 0 0" />
                        <Border Name="frame" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Background="Transparent"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Foreground="{TemplateBinding Foreground}" />
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{StaticResource PsAccentDark}" />
        </Style>
        <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PsOnAccent}" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PsOnAccent}" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Background" Value="#24FFFFFF" />
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PsMuted}" />
        </Style>

        <!-- Secondary: a hairline frame, no ink -->
        <Style Selector="Button.Secondary">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PsText}" />
            <Setter Property="BorderBrush" Value="{StaticResource PsRuleStrong}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.Secondary:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource PsAccent}" />
        </Style>
        <Style Selector="Button.Secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource PsAccent}" />
        </Style>
        <Style Selector="Button.Secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource PsAccent}" />
        </Style>
        <Style Selector="Button.Secondary:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource PsRule}" />
        </Style>

        <!-- ============ Mode selectors: a hairline frame; the chosen one is printed in coolant ============ -->
        <Style Selector="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinWidth" Value="124" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PsText}" />
            <Setter Property="BorderBrush" Value="{StaticResource PsRuleStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18 0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border Name="plateA" Background="{TemplateBinding Background}" Margin="0 0 5 3" />
                        <Border Name="plateB" Background="{TemplateBinding Background}" Margin="5 3 0 0" />
                        <Border Name="frame" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}" />
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource PsText}" />
        </Style>
        <Style Selector="RadioButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource PsText}" />
        </Style>
        <Style Selector="RadioButton:checked">
            <Setter Property="Background" Value="{StaticResource PsAccent}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="RadioButton:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource PsOnAccent}" />
            <Setter Property="FontFamily" Value="{StaticResource SemiFont}" />
        </Style>
        <Style Selector="RadioButton:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <!-- ============ Inputs ============ -->
        <Style Selector="Slider">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="TickFrequency" Value="10" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource PsAccent}" />
        </Style>

        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource PsAccent}" />
            <Setter Property="Background" Value="#24FFFFFF" />
            <Setter Property="MinHeight" Value="3" />
            <Setter Property="Height" Value="3" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="ProgressBar.Second">
            <Setter Property="Foreground" Value="{StaticResource PsSecond}" />
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource PsText}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource PsRuleStrong}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style Selector="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
    </Application.Styles>
</Application>
