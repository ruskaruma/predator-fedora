<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PredatorCore.Dashboard"
             xmlns:local="clr-namespace:PredatorCore"
             xmlns:avalonia="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             x:DataType="local:Dashboard">

    <UserControl.Styles>
        <Style Selector="local|ArcGauge">
            <Setter Property="Width" Value="132" />
            <Setter Property="Height" Value="132" />
            <Setter Property="Thickness" Value="6" />
        </Style>
        <Style Selector="Grid.KV > TextBlock.Label">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid.KV > TextBlock.Value">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="44 34 48 12">

            <!-- Page header -->
            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="Monitoring" Classes="SectionHeader" />
                    <TextBlock Text="{Binding Monitoring.ModelName}" Classes="SectionSub" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Bottom" Margin="0 0 28 34">
                    <TextBlock Text="{Binding Monitoring.ThrottleText}" Foreground="{StaticResource PsCritical}"
                               FontFamily="{StaticResource SemiFont}" HorizontalAlignment="Right"
                               IsVisible="{Binding Monitoring.IsThrottling}" />
                    <TextBlock Text="{Binding Monitoring.Uptime, StringFormat='Up for {0}'}" Classes="Label"
                               HorizontalAlignment="Right" />
                </StackPanel>
                <Image Grid.Column="2" Source="avares://PredatorCore/Assets/Art/spot-chip.png" Width="148" Height="148"
                       Margin="0 -18 0 10" VerticalAlignment="Top"
                       RenderOptions.BitmapInterpolationMode="HighQuality" />
            </Grid>

            <!-- Row 1: gauges -->
            <UniformGrid Columns="4">
                <Border Classes="Card" Margin="0 0 14 38">
                    <StackPanel>
                        <TextBlock Text="CPU temperature" Classes="SubHeader" />
                        <Grid Margin="0 14 0 0" HorizontalAlignment="Center">
                            <local:ArcGauge Value="{Binding CpuTemp}" Maximum="100" WarnAt="0.8" CriticalAt="0.93"
                                            Accent="#4FC3DC" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="CpuTemperature" Classes="BigValue" HorizontalAlignment="Center"
                                           Text="{Binding CpuTemp, StringFormat='{}{0:0}°'}" />
                                <TextBlock Text="Celsius" Classes="Label" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="Card" Margin="0 0 14 38">
                    <StackPanel>
                        <TextBlock Text="GPU temperature" Classes="SubHeader" />
                        <Grid Margin="0 14 0 0" HorizontalAlignment="Center">
                            <local:ArcGauge Value="{Binding GpuTemp}" Maximum="100" WarnAt="0.8" CriticalAt="0.9"
                                            Accent="#EBE5C8" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="GpuTemperature" Classes="BigValue" HorizontalAlignment="Center"
                                           Text="{Binding Monitoring.GpuTempText}" />
                                <TextBlock Text="Celsius" Classes="Label" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="Card" Margin="0 0 14 38">
                    <StackPanel>
                        <TextBlock Text="CPU load" Classes="SubHeader" />
                        <Grid Margin="0 14 0 0" HorizontalAlignment="Center">
                            <local:ArcGauge Value="{Binding CpuUsage}" Maximum="100" WarnAt="0.85" CriticalAt="0.97"
                                            Accent="#4FC3DC" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Classes="BigValue" HorizontalAlignment="Center"
                                           Text="{Binding CpuUsage, StringFormat='{}{0:0}%'}" />
                                <TextBlock Text="{Binding Monitoring.CpuClock}" Classes="Label"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="Card" Margin="0 0 0 38">
                    <StackPanel>
                        <TextBlock Text="GPU load" Classes="SubHeader" />
                        <Grid Margin="0 14 0 0" HorizontalAlignment="Center">
                            <local:ArcGauge Value="{Binding GpuUsage}" Maximum="100" WarnAt="0.85" CriticalAt="0.97"
                                            Accent="#EBE5C8" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Classes="BigValue" HorizontalAlignment="Center"
                                           Text="{Binding Monitoring.GpuLoadText}" />
                                <TextBlock Text="{Binding Monitoring.GpuClock}" Classes="Label"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Row 2: processor, graphics, cooling -->
            <Grid ColumnDefinitions="*,*,*">
                <Border Classes="Card" Grid.Column="0" Margin="0 0 14 38">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="CpuTitle" Text="Processor" Classes="SubHeader" />
                        <TextBlock x:Name="CpuModel" Text="{Binding CpuName}" Classes="Label" TextWrapping="Wrap" />
                        <Grid Classes="KV" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                              RowSpacing="8">
                            <TextBlock Grid.Row="0" Text="Average clock" Classes="Label" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Monitoring.CpuClock}" Classes="Value" />
                            <TextBlock Grid.Row="1" Text="Fastest core" Classes="Label" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Monitoring.CpuClockMax}"
                                       Classes="Value" />
                            <TextBlock Grid.Row="2" Text="Package power" Classes="Label" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Monitoring.CpuPower}" Classes="Value" />
                            <TextBlock Grid.Row="3" Text="Threads" Classes="Label" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Monitoring.CpuThreadsText}"
                                       Classes="Value" />
                            <TextBlock Grid.Row="4" Text="Policy" Classes="Label" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Monitoring.CpuPolicy}"
                                       Classes="Value" />
                            <TextBlock Grid.Row="5" Text="Throttling" Classes="Label" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Monitoring.ThrottleSummary}"
                                       Classes="Value" />
                        </Grid>
                        <ProgressBar x:Name="CpuTemperatureBar" Value="{Binding CpuUsage}" Maximum="100" Margin="0 4 0 0" />
                    </StackPanel>
                </Border>

                <Border Classes="Card" Grid.Column="1" Margin="0 0 14 38">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="GpuTitle" Text="Graphics" Classes="SubHeader" />
                        <TextBlock x:Name="GpuModel" Text="{Binding GpuName}" Classes="Label" TextWrapping="Wrap" />
                        <Grid Classes="KV" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                              RowSpacing="8">
                            <TextBlock Grid.Row="0" Text="State" Classes="Label" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Monitoring.GpuState}" Classes="Value" />
                            <TextBlock Grid.Row="1" Text="Core clock" Classes="Label" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Monitoring.GpuClock}" Classes="Value" />
                            <TextBlock Grid.Row="2" Text="Board power" Classes="Label" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Monitoring.GpuPower}" Classes="Value" />
                            <TextBlock Grid.Row="3" Text="Video memory" Classes="Label" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Monitoring.GpuVram}" Classes="Value" />
                            <TextBlock Grid.Row="4" Text="Driver" Classes="Label" />
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="GpuDriver" Text="—" Classes="Value" />
                        </Grid>
                        <ProgressBar x:Name="GpuTemperatureBar" Classes="Second" Margin="0 4 0 0"
                                     Value="{Binding Monitoring.GpuVramPercent}" Maximum="100" />
                    </StackPanel>
                </Border>

                <Border Classes="Card" Grid.Column="2" Margin="0 0 0 38">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="FanControlTitle" Text="Cooling" Classes="SubHeader" />
                        <UniformGrid Columns="2" Margin="0 4 0 0">
                            <StackPanel HorizontalAlignment="Center" Spacing="6">
                                <local:FanDial x:Name="CpuFanIcon" Width="92" Height="92" HorizontalAlignment="Center"
                                               Percent="{Binding Monitoring.CpuFanPercent}" Accent="#4FC3DC" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
                                    <TextBlock x:Name="CpuFanSpeed" Text="0" Classes="BigValue" FontSize="24" />
                                    <TextBlock Text="rpm" Classes="Label" VerticalAlignment="Bottom" Margin="0 0 0 5" />
                                </StackPanel>
                                <TextBlock Text="CPU fan" Classes="Label" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center" Spacing="6">
                                <local:FanDial x:Name="GpuFanIcon" Width="92" Height="92" HorizontalAlignment="Center"
                                               Percent="{Binding Monitoring.GpuFanPercent}" Accent="#EBE5C8" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
                                    <TextBlock x:Name="GpuFanSpeed" Text="0" Classes="BigValue" FontSize="24" />
                                    <TextBlock Text="rpm" Classes="Label" VerticalAlignment="Bottom" Margin="0 0 0 5" />
                                </StackPanel>
                                <TextBlock Text="GPU fan" Classes="Label" HorizontalAlignment="Center" />
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel Spacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="CPU fan duty, of 7400 rpm" Classes="Label" />
                                <TextBlock Grid.Column="1" Classes="Label"
                                           Text="{Binding Monitoring.CpuFanPercent, StringFormat='{}{0:0}%'}" />
                            </Grid>
                            <ProgressBar Value="{Binding Monitoring.CpuFanPercent}" Maximum="100" />
                            <Grid ColumnDefinitions="*,Auto" Margin="0 8 0 0">
                                <TextBlock Text="GPU fan duty, of 7400 rpm" Classes="Label" />
                                <TextBlock Grid.Column="1" Classes="Label"
                                           Text="{Binding Monitoring.GpuFanPercent, StringFormat='{}{0:0}%'}" />
                            </Grid>
                            <ProgressBar Classes="Second" Value="{Binding Monitoring.GpuFanPercent}" Maximum="100" />
                        </StackPanel>
                        <!-- Kept for code-behind compatibility -->
                        <ComboBox x:Name="FanModeSelector" IsVisible="False" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 3: temperature history and battery -->
            <Grid ColumnDefinitions="2*,*">
                <Border Classes="Card" Grid.Column="0" Margin="0 0 14 38">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="TemperatureMonitorTitle" Text="Temperature, last two minutes"
                                       Classes="SubHeader" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16"
                                        VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="14" Height="2" Background="{StaticResource PsAccent}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="CPU" Classes="Label" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="14" Height="2" Background="{StaticResource PsSecond}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="GPU" Classes="Label" />
                                </StackPanel>
                                <TextBlock Text="{Binding LatestReadingText}" Classes="Label"
                                           Foreground="{StaticResource PsText}" />
                            </StackPanel>
                        </Grid>
                        <avalonia:CartesianChart x:Name="TemperatureChart" Height="230" Margin="0 8 0 0" />
                    </StackPanel>
                </Border>

                <Border Classes="Card" Grid.Column="1" Margin="0 0 0 38" IsVisible="{Binding HasBattery}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="BatteryTitle" Text="Battery" Classes="SubHeader" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="BatteryPercentage" Classes="BigValue" FontSize="40"
                                       Text="{Binding BatteryPercentageInt, StringFormat='{}{0}%'}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="PowerSource" Text="{Binding BatteryStatus}" Classes="Value" />
                                <TextBlock Text="{Binding Monitoring.BatteryWatts}" Classes="Label" />
                            </StackPanel>
                        </StackPanel>
                        <ProgressBar x:Name="BatteryLevelBar" Value="0" Maximum="100" Foreground="{StaticResource PsGood}" />
                        <Grid Classes="KV" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8"
                              Margin="0 4 0 0">
                            <TextBlock Grid.Row="0" Text="Time left" Classes="Label" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="BatteryTimeRemaining" Text="—"
                                       Classes="Value" />
                            <TextBlock Grid.Row="1" Text="Health" Classes="Label" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Monitoring.BatteryHealth}"
                                       Classes="Value" />
                            <TextBlock Grid.Row="2" Text="Charge cycles" Classes="Label" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Monitoring.BatteryCycles}"
                                       Classes="Value" />
                        </Grid>
                        <ComboBox x:Name="PowerModeSelector" IsVisible="False" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 4: what's heating the laptop, and who keeps the GPU awake -->
            <Grid ColumnDefinitions="2*,*">
                <Border Classes="Card" Grid.Column="0" Margin="0 0 14 38">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="What's heating your laptop" Classes="SubHeader" />
                            <TextBlock Grid.Column="1" Text="CPU use, where 100% is one core" Classes="Label"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding TopProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:ProcessRow">
                                    <Grid ColumnDefinitions="*,160,60,82" Margin="0 4">
                                        <StackPanel VerticalAlignment="Center" Margin="0 0 18 0">
                                            <TextBlock Text="{Binding Name}" Classes="Value" FontSize="14"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Classes="Label" />
                                        </StackPanel>
                                        <ProgressBar Grid.Column="1" Value="{Binding BarPercent}" Maximum="100"
                                                     VerticalAlignment="Center" Foreground="{StaticResource PsCritical}" />
                                        <TextBlock Grid.Column="2" Text="{Binding CpuText}" Classes="Value"
                                                   TextAlignment="Right" VerticalAlignment="Center" />
                                        <!-- fixed column keeps bars aligned whether or not a row can be ended -->
                                        <Button Grid.Column="3" Content="End" Classes="Secondary"
                                                HorizontalAlignment="Right" Padding="14 3" MinHeight="28" FontSize="13"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding CanEnd}" Click="EndProcess_OnClick" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Classes="Card" Grid.Column="1" Margin="0 0 0 38">
                    <StackPanel Spacing="10">
                        <TextBlock Text="GPU power" Classes="SubHeader" />
                        <TextBlock Text="{Binding Monitoring.GpuState}" Classes="Value" />
                        <TextBlock Text="{Binding Monitoring.GpuSleepSummary}" Classes="Label" TextWrapping="Wrap" />

                        <Border x:Name="GpuPowerControls" IsVisible="False">
                            <UniformGrid Columns="2" Margin="0 6 0 2">
                                <UniformGrid.Styles>
                                    <Style Selector="RadioButton">
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="Height" Value="40" />
                                        <Setter Property="Padding" Value="8 0" />
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="FontSize" Value="14" />
                                    </Style>
                                </UniformGrid.Styles>
                                <RadioButton x:Name="GpuAutoSleepRadio" GroupName="GpuPower" Tag="auto" Margin="0 0 6 0"
                                             Content="Auto sleep" IsCheckedChanged="GpuPowerMode_OnChecked" />
                                <RadioButton x:Name="GpuAlwaysOnRadio" GroupName="GpuPower" Tag="on" Margin="6 0 0 0"
                                             Content="Always on" IsCheckedChanged="GpuPowerMode_OnChecked" />
                            </UniformGrid>
                        </Border>

                        <TextBlock Text="{Binding Monitoring.GpuClients, StringFormat='Using the GPU: {0}'}"
                                   Classes="Hint" Foreground="{StaticResource PsSoft}" />
                        <TextBlock Classes="Hint"
                                   Text="Auto sleep powers the RTX 4060 down whenever nothing needs it, which saves several watts. Always on keeps it ready for games and CUDA." />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 5: memory, storage, network, system -->
            <UniformGrid Columns="4">
                <Border Classes="Card" Margin="0 0 14 24">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Memory" Classes="SubHeader" />
                        <TextBlock Text="{Binding Monitoring.RamText}" Classes="Value" />
                        <ProgressBar Value="{Binding Monitoring.RamPercent}" Maximum="100" />
                        <TextBlock Text="{Binding Monitoring.SwapText, StringFormat='Swap in use: {0}'}"
                                   Classes="Label" />
                    </StackPanel>
                </Border>

                <Border Classes="Card" Margin="0 0 14 24">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Storage" Classes="SubHeader" />
                        <TextBlock Text="{Binding Monitoring.DiskText}" Classes="Value" />
                        <ProgressBar Value="{Binding Monitoring.DiskPercent}" Maximum="100" />
                        <TextBlock Text="{Binding Monitoring.NvmeTemp, StringFormat='NVMe temperature: {0}'}"
                                   Classes="Label" />
                    </StackPanel>
                </Border>

                <Border Classes="Card" Margin="0 0 14 24">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Network" Classes="SubHeader" />
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                            <TextBlock Text="Down" Classes="Label" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Monitoring.NetDown}" Classes="Value" />
                            <TextBlock Grid.Row="1" Text="Up" Classes="Label" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Monitoring.NetUp}" Classes="Value" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="Card" Margin="0 0 0 24">
                    <StackPanel Spacing="8">
                        <TextBlock Text="System" Classes="SubHeader" />
                        <TextBlock Text="{Binding OsVersion}" Classes="Value" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding KernelVersion, StringFormat='Kernel {0}'}" Classes="Label"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Monitoring.LoadAvg, StringFormat='Load {0}'}" Classes="Label" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
